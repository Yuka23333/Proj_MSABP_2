# CST Studio Suite
#
# A standalone "name.cst" project recreates a large sibling "name/" directory
# when opened. Immediate child directories under simulations/ are therefore
# treated as generated CST working/result data, except for the managed project
# structure below.
/simulations/*/
!/simulations/models/
!/simulations/templates/
!/simulations/runs/
/simulations/*.bak[0-9]*

# models/ is a CST isolation zone: only standalone project containers and its
# README are versioned. Any sibling folder/cache/backup regenerated by CST stays
# local, regardless of its name.
/simulations/models/*
!/simulations/models/*.cst
!/simulations/models/README.md

# Runtime logs and generated simulation data
logs/*
!logs/.gitkeep
simulations/runs/*
!simulations/runs/.gitkeep
results/raw/*
!results/raw/.gitkeep
results/processed/*
!results/processed/.gitkeep
!results/processed/antenna_polygon_vertices.json
!results/processed/doe_round*_summary.json
results/figures/*
!results/figures/.gitkeep

# Large generated geometry-label arrays stay local; reproducible CSV worklists
# and their round summaries are versioned instead.
data/samples/*.npy

# Common temporary files
*.tmp
*.temp
*.cst~
~$*

# Local scratch notes
/history_list.txt
